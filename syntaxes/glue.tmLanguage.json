{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GlueIR",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.glue",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.glue",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.glue",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.glue",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.other.glue",
          "match": "\\b(func)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.glue",
          "match": "\\b(int|boolean|bool|double|string|void|float)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.glue",
          "match": "\\b(true|false|sticky|const)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.glue",
          "match": "\\b(shout|shin|random|toInt|toDouble|toFloat)\\b"
        },
        {
          "name": "entity.name.function.glue",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.glue",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.glue"
}